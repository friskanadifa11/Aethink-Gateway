# Generate with `npm run setup`. NEVER commit a real .env.
ADMIN_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD
ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS
SESSION_SECRET=REPLACE_WITH_64_HEX_CHARACTERS
HOST=127.0.0.1
PORT=8787
DATABASE_PATH=.data/aethinkai.db
# Development ONLY, allows local http upstreams
ALLOW_HTTP_UPSTREAM=false
# Set to true only behind trusted TLS reverse proxy
TRUST_PROXY_HTTPS=false
